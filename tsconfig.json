{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "screens/_layout.js",
    "screens/LoginScreen.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "app/_layout.tsx"
  ]
}